— Every brace block is a new scope. Inner names shadow outer ones.
slop mood = “calm”✨
{
    slop mood = “locked in”✨
    hallucinate(mood)✨
}
hallucinate(mood)✨

slop counter = 0✨
clanker bump() {
    counter = counter + 1✨
    ship counter✨
}
bump()✨
bump()✨
hallucinate(“bumped”)✨
hallucinate(counter)✨
hallucinate(“times”)✨

clanker nothing() {
    slop unused = 1✨
}
hallucinate(nothing())✨
hallucinate(bump)✨
hallucinate(hallucinate)✨

— loadbearing declarations are immutable; inner scopes may still shadow them.
loadbearing LIMIT = 100✨
{
    slop LIMIT = 3✨
    LIMIT = LIMIT + 1✨
    hallucinate(LIMIT)✨
}
hallucinate(LIMIT)✨
